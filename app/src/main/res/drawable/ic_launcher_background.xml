<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Base Deep Space Backdrop -->
    <path
        android:fillColor="#0B0F19"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Vibrant Gradient Glow Field -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="315"
                android:endColor="#0F172A"
                android:centerColor="#312E81"
                android:startColor="#4F46E5"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Top-Right Cyan Ambient Glow -->
    <path
        android:pathData="M70,8a30,30 0 1,0 0.1,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="75"
                android:centerY="25"
                android:gradientRadius="35"
                android:startColor="#6006B6D4"
                android:endColor="#0006B6D4"
                android:type="radial" />
        </aapt:attr>
    </path>

    <!-- Bottom-Left Pink/Magenta Ambient Glow -->
    <path
        android:pathData="M25,85a30,30 0 1,0 0.1,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="25"
                android:centerY="85"
                android:gradientRadius="35"
                android:startColor="#60EC4899"
                android:endColor="#00EC4899"
                android:type="radial" />
        </aapt:attr>
    </path>
</vector>
